<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/md_theme_surface"
    app:cardCornerRadius="10dp"
    app:strokeColor="@color/md_theme_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/itemCodeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/md_theme_primary"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/itemMetaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Status/Info -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemStatusButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:contentDescription="@string/access_code_check_status_short"
                app:icon="@drawable/ic_baseline_info_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/md_theme_secondary" />

            <!-- Use/Edit -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemUseButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:contentDescription="@string/access_code_use_for_update"
                app:icon="@drawable/ic_baseline_edit_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/md_theme_primary" />

            <!-- Revoke -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemRevokeButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:contentDescription="@string/access_code_revoke_short"
                app:icon="@drawable/ic_baseline_block_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/md_theme_error" />

            <!-- Delete -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/itemDeleteButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="0dp"
                android:contentDescription="@string/access_code_delete_short"
                app:icon="@drawable/ic_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@color/md_theme_error" />

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

