rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        (request.auth.uid == "KCKVGF5sJ7TfGWKAl0fRJziE4Ja2" ||
         request.auth.uid == "NFs38qPJAXXZFspS37nRhteROWn1");
    }

    function isAllowedVersion() {
      // Strictly authorized for v8.x ecosystem
      return request.resource.data.version in ["8.0.0", "8.1.0", "8.1.1", "8.2.0"];
    }

    // Attendance data
    match /attendance_records/{docId} {
      allow read: if true;

      allow create: if isAllowedVersion();

      // PROTECTED UPDATE: Only allow setting a time field if it's currently empty or "-"
      // This prevents Phone B from overwriting Phone A's data without costing extra Reads.
      allow update: if isAllowedVersion() && (
        (!('time_in_am' in request.resource.data) || resource.data.time_in_am == "-" || !('time_in_am' in resource.data)) &&
        (!('time_out_am' in request.resource.data) || resource.data.time_out_am == "-" || !('time_out_am' in resource.data)) &&
        (!('time_in_pm' in request.resource.data) || resource.data.time_in_pm == "-" || !('time_in_pm' in resource.data)) &&
        (!('time_out_pm' in request.resource.data) || resource.data.time_out_pm == "-" || !('time_out_pm' in resource.data))
      );

      allow delete: if isAdmin();
    }

    // Student Masterlist for Absent Checker
    match /student_masterlist/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/admin {
      allow read: if true;
      allow write: if false;
    }

    match /access_codes/{code} {
      allow read, write: if false;
      match /activations/{deviceId} {
        allow read, write: if false;
      }
    }

    match /access_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
