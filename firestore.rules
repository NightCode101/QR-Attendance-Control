rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        (request.auth.uid == "KCKVGF5sJ7TfGWKAl0fRJziE4Ja2" ||
         request.auth.uid == "NFs38qPJAXXZFspS37nRhteROWn1");
    }

    function isAllowedVersion() {
      // Authorized versions for current platform
      return request.resource.data.version in ["8.0.0", "8.1.0"];
    }

    // Attendance data
    match /attendance_records/{docId} {
      // Keep public read if history visible without auth
      allow read: if true;

      // Sync model (unauth write allowed) but version-gated
      allow create, update: if isAllowedVersion();

      // Delete only admins
      allow delete: if isAdmin();
    }

    // Student Masterlist for Absent Checker
    match /student_masterlist/{docId} {
      // Allow all users to read (for local cache sync)
      allow read: if true;
      // Only admins can modify the masterlist
      allow write: if isAdmin();
    }

    // Allow reading the admin configuration document
    match /config/admin {
      allow read: if true;
      allow write: if false;
    }

    // Access-code system (client should NOT read/write directly)
    match /access_codes/{code} {
      allow read, write: if false;

      match /activations/{deviceId} {
        allow read, write: if false;
      }
    }

    // Optional audit logs
    match /access_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
